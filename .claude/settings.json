{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "pobsteta": {
      "source": {
        "source": "github",
        "repo": "pobsteta/methode-imperatrice"
      }
    }
  },
  "enabledPlugins": {
    "imperatrice@pobsteta": true
  },
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)"
    ]
  }
}
